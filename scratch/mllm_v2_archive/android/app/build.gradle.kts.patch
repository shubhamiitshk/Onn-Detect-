// Add these dependencies to android/app/build.gradle.kts for MLLM support
//
// Gemma 3n E2B on-device MLLM via LiteRT-LM (Google AI Edge)
// This enables fully offline semantic analysis for AI-generated content detection

dependencies {
    // ... existing dependencies ...

    // ══════════════════════════════════════════════════════════════
    // LiteRT-LM: On-device LLM inference (Gemma 3n E2B)
    // ══════════════════════════════════════════════════════════════
    // Google AI Edge LiteRT-LM for multimodal on-device inference
    implementation("com.google.ai.edge.litert:litert:1.0.0")
    implementation("com.google.ai.edge.litert:litert-support:1.0.0")
    implementation("com.google.ai.edge.litert:litert-media:1.0.0")

    // Optional: Qualcomm AI Stack for Hexagon NPU acceleration
    // Uncomment if targeting Snapdragon devices:
    // implementation("com.qualcomm.qti.ai.sdke:litert-delegate-npu:1.0.0")

    // ══════════════════════════════════════════════════════════════
    // Guava: Required by LiteRT-LM for hashing and utilities
    // ══════════════════════════════════════════════════════════════
    implementation("com.google.guava:guava:33.0.0-android")
}

