# Optional credentials for the ML training/export workflows.
# Copy to .env and fill in; never commit real secrets.
WANDB_API_KEY=

# Root of the downloaded datasets (see scripts/download_all_datasets.sh).
# ONN_DATA_ROOT=/path/to/datasets

# Root of trained/exported model artifacts.
# ONN_MODEL_ROOT=/path/to/models

# Android release signing (see android/app/build.gradle.kts).
# ONN_RELEASE_STORE_FILE=/path/to/keystore.jks
# ONN_RELEASE_STORE_PASSWORD=
# ONN_RELEASE_KEY_ALIAS=
# ONN_RELEASE_KEY_PASSWORD=

# Pinned SHA-256 for the C2PA trust-anchor bundle (see scripts/fetch_c2pa_trust_anchors.sh).
# C2PA_TRUST_ANCHORS_SHA256=