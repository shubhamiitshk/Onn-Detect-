<?xml version="1.0" encoding="utf-8"?>
<!-- AGP 8 forbids package= here; namespace lives in app/build.gradle.kts -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy First: NO INTERNET PERMISSION -->
    <!-- Selected-file URI grants require no broad storage/camera permissions.
         Reject network permissions introduced by transitive libraries. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application android:networkSecurityConfig="@xml/network_security_config"
        android:name=".OnnDetectApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnnDetect">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OnnDetect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-sheet target: "share -> ONN-DETECT" is the zero-permission
                 distribution surface for images, voice notes, and video clips.
                 The hand-off is a content:// URI copied safely by ProviderMediaImporter. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
