<?xml version="1.0" encoding="utf-8"?>
<!-- AGP 8 forbids package= here; namespace lives in app/build.gradle.kts -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy First: NO INTERNET PERMISSION -->
    <!-- Selected-file URI grants require no broad storage/camera permissions.
         Reject network permissions introduced by transitive libraries. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application android:networkSecurityConfig="@xml/network_security_config"
        android:name=".OnnDetectApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnnDetect">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OnnDetect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-sheet target: "share -> ONN-DETECT" is the only
                 distribution surface that needs no permission, no background
                 service and no network call. The hand-off is a content://
                 URI, which the existing importer already copies safely.
                 VIDEO is deliberately NOT declared: the video-level blend is
                 not calibrated on a video split (VideoScorePolicy's temporal
                 weight is 0), and offering an uncalibrated verdict in a
                 share sheet is exactly what this project has refused to do
                 everywhere else. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>

